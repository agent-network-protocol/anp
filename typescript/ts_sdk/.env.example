# Local-only secrets for did:bid live tests. Copy to `.env` (gitignored) and fill in.
# NEVER commit real keys. The ANP SDK itself never reads this file; only the test
# harness loads it, e.g.:
#   node --env-file=.env ./node_modules/vitest/vitest.mjs --run tests/did-bid.test.ts

# Resolution service base URL (trailing slash required).
ANP_BID_PARSER_URL=https://xinghuoid.zetrix.com/bid/

# Optional: did:bid used by the opt-in live resolve/sign tests.
# ANP_BID_TEST_DID=did:bid:ef...

# Optional: starfire-encoded private key (priSPK...) enabling the live signing test.
# NEVER commit a real value.
# ANP_BID_TEST_PRIVATE_KEY=priSPK...